{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Repository-local Renovate policy for ssh-mcp-pro.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":separateMultipleMajorReleases",
    "group:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Europe/Istanbul",
  "minimumReleaseAge": "7 days",
  "labels": ["dependencies"],
  "dependencyDashboard": {
    "labels": ["dependencies"],
    "title": "Dependency Dashboard",
    "osvVulnerabilitySummary": "unresolved"
  },
  "assignees": ["oaslananka"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "commitHourlyLimit": 4,
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "automerge": false,
    "addLabels": ["lockfile", "requires-review"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security", "risk:high", "requires-review"],
    "prCreation": "immediate",
    "vulnerabilityFixStrategy": "highest"
  },
  "osvVulnerabilityAlerts": false,
  "packageRules": [
    {
      "description": "Delegate low-risk dependency merging to Mergify.",
      "matchUpdateTypes": ["patch", "digest", "pin"],
      "automerge": false,
      "addLabels": ["automerge:enabled", "risk:low"]
    },
    {
      "description": "Delegate stable minor development dependency updates to Mergify after CI.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "!/^0/",
      "automerge": false,
      "addLabels": ["automerge:enabled", "risk:low"]
    },
    {
      "description": "Require explicit approval for major version changes.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "addLabels": ["major", "requires-review"],
      "prPriority": -5,
      "automerge": false
    },
    {
      "description": "Apply npm release-age guard to reduce supply-chain churn.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days",
      "prCreation": "immediate",
      "internalChecksFilter": "strict",
      "addLabels": ["javascript"]
    },
    {
      "description": "Pin and group non-major GitHub Actions updates.",
      "matchManagers": ["github-actions"],
      "minimumReleaseAge": "7 days",
      "prCreation": "immediate",
      "internalChecksFilter": "strict",
      "pinDigests": true,
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "addLabels": ["ci", "github-actions"]
    },
    {
      "description": "Group TypeScript quality toolchain updates.",
      "matchPackageNames": [
        "typescript",
        "ts-node",
        "tsx",
        "eslint",
        "eslint-*",
        "@eslint/**",
        "@typescript-eslint/**",
        "typescript-eslint",
        "prettier",
        "@types/**"
      ],
      "groupName": "TypeScript quality toolchain",
      "groupSlug": "typescript-quality-toolchain",
      "addLabels": ["javascript"]
    },
    {
      "description": "MCP SDK and SSH/runtime-affecting dependencies require manual review.",
      "matchPackageNames": [
        "@modelcontextprotocol/core",
        "@modelcontextprotocol/server",
        "@modelcontextprotocol/node",
        "@modelcontextprotocol/server-legacy",
        "@modelcontextprotocol/client",
        "ssh2",
        "node-ssh",
        "node-pty",
        "execa",
        "jose",
        "ws",
        "zod",
        "@hono/node-server",
        "@grpc/grpc-js",
        "@opentelemetry/**"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": ["requires-review", "runtime-risk"]
    },
    {
      "description": "Keep Node runtime jumps explicit.",
      "matchPackageNames": ["node", "@types/node"],
      "dependencyDashboardApproval": true,
      "addLabels": ["runtime-risk", "requires-review"]
    },
    {
      "description": "Update all active pnpm toolchain pins together.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm toolchain",
      "groupSlug": "pnpm-toolchain"
    }
  ],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track active pnpm pins outside package.json.",
      "managerFilePatterns": [
        ".github/workflows/ci.yml",
        ".github/workflows/docs.yml",
        ".github/workflows/mcp-registry.yml",
        ".github/workflows/release.yml",
        "CONTRIBUTING.md",
        "Dockerfile",
        "Dockerfile.coolify",
        "Dockerfile.test",
        "MIGRATION.md",
        "README.md",
        "docs/development/local-setup.md",
        "docs/reference/compatibility.md",
        "docs/tutorials/getting-started.md"
      ],
      "matchStrings": [
        "(?:pnpm@|PNPM_VERSION:[ \\t]+|pnpm(?: must satisfy)?[ \\t]+`?\\^?)(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
