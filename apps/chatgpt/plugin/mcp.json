{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ssh-mcp-pro": {
      "type": "streamable-http",
      "url": "https://ssh-mcp-pro.oaslananka.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "hosts:read",
              "agents:read",
              "status:read"
            ]
          }
        }
      }
    }
  }
}
