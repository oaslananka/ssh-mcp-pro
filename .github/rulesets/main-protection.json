{
  "name": "main-standard",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 285490571,
      "actor_type": "User",
      "bypass_mode": "pull_request"
    }
  ],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Quality Gates"
          },
          {
            "context": "Unit Tests (Node 26)"
          },
          {
            "context": "Unit Tests (Node 24)"
          },
          {
            "context": "SSH Integration"
          },
          {
            "context": "Windows Command-Path Integration"
          },
          {
            "context": "SSH E2E"
          },
          {
            "context": "Build, SBOM, and Pack"
          },
          {
            "context": "Build and smoke image"
          },
          {
            "context": "Validate MCP Registry metadata"
          },
          {
            "context": "Secret scan (full history)"
          },
          {
            "context": "Dependency Review"
          },
          {
            "context": "SonarCloud Code Analysis"
          },
          {
            "context": "Codacy Static Code Analysis",
            "integration_id": 56611
          }
        ]
      }
    }
  ]
}
